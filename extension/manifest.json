{
  "manifest_version": 3,
  "name": "Anti Procrastination AI",
  "version": "1.0",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": ["http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}